# Copia este archivo como ".env" y completa los valores.
# Los encuentras en Supabase: Project Settings -> API.
# SOLO la URL y la clave "anon" (pública). NUNCA pongas la clave "service_role" aquí.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica
# Dirección pública del sitio (sin "/" al final). Se usa en las vistas previas al compartir el enlace.
VITE_SITE_URL=https://tu-sitio.vercel.app
